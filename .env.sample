# ===========================================
# Multi-Platform Bot Configuration
# ===========================================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/multiplatform-bot

# General Bot Configuration
BOT_NAME=Coffee Bot
TIMEZONE=Africa/Lagos
NODE_ENV=development

# ===========================================
# Platform Configuration
# ===========================================
# Enable/disable platforms (true/false)
WHATSAPP_ENABLED=true
DISCORD_ENABLED=false
TWITTER_ENABLED=false

# ===========================================
# WhatsApp Configuration
# ===========================================
# Session backup interval in milliseconds (default: 5 minutes)
WHATSAPP_SESSION_BACKUP_INTERVAL=300000

# ===========================================
# Discord Configuration (when enabled)
# ===========================================
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# ===========================================
# Twitter Configuration (when enabled)
# ===========================================
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ===========================================
# Announcement Channel Detection
# ===========================================
# The bot will auto-detect announcement channels by looking for:
# - Channels with "announcement" in the name (case-insensitive)
# - Channels with "updates" in the name
# - Or you can specify exact names (comma-separated)
ANNOUNCEMENT_CHANNEL_KEYWORDS=announcement,updates,news,broadcast

# Fallback: Specific channel name if auto-detect fails (optional)
# Leave empty to skip if no channel is found
ANNOUNCEMENT_CHANNEL_FALLBACK=


